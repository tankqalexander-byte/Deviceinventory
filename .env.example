# Settings for the Node server (npm run dev / npm start). For local Cloudflare testing (npm run cf:dev), put overrides such as AUTH_DISABLED=true in a .dev.vars file instead.

# DATABASE_URL: PostgreSQL connection string for the app's data.
# Production: postgres://USER:PASSWORD@HOST:5432/DBNAME (e.g. Cloud SQL).
# Leave unset in development to use an embedded Postgres (PGlite) stored in ./data/pglite.
# DATABASE_URL="postgres://user:password@localhost:5432/device_inventory"

# AUTH_DISABLED: set to "true" ONLY for local development without Firebase sign-in.
# AUTH_DISABLED="false"

# ALLOWED_EMAILS: Google accounts allowed to use the app, comma-separated.
# Use "@domain.com" to allow a whole domain. Empty = nobody can get in.
# ALLOWED_EMAILS="you@gmail.com"
